---
import LetterGlitch from "@/React/LetterGlitch";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title} | Vannilavan C</title>
    <meta
      name="description"
      content="Vannilavan C - AI & Data Science undergraduate with experience across AI internships, AWS cloud computing, and full-stack project development."
    />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />

    <link
      rel="preload"
      href="/fonts/montserrat-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <meta
      property="og:title"
      content="Vannilavan C | AI & Data Science Engineer"
    />
    <meta
      property="og:description"
      content="Portfolio of Vannilavan C, AI & Data Science undergraduate specializing in generative AI, cloud computing, and predictive models."
    />
    <meta property="og:type" content="website" />
    <meta
      property="og:site_name"
      content="Vannilavan C Portfolio"
    />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Vannilavan C",
        "jobTitle": "AI & Data Science Engineer",
        "email": "vannilavanchandrasekaran@gmail.com",
        "telephone": "+919042214770",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Karur",
          "addressRegion": "Tamil Nadu",
          "addressCountry": "India"
        },
        "sameAs": [
          "https://github.com/Vannilavan05",
          "https://linkedin.com/in/vannilavan-chandrasekaran-537223317"
        ],
        "description": "AI & Data Science undergraduate with hands-on experience across AI internships, cloud computing (AWS), and generative AI APIs."
      }
    </script>
  </head>
  <body class="bg-[--background] text-[var(--white)] selection:bg-[var(--sec)] selection:text-[var(--background)] min-h-screen relative overflow-x-hidden">
    {/* Global matrix letter glitch background across the entire page with low transparency */}
    <div class="fixed inset-0 pointer-events-none z-0 opacity-20 overflow-hidden">
      <LetterGlitch
        client:load
        glitchColors={["#5e4491", "#A476FF", "#241a38"]}
        glitchSpeed={35}
        centerVignette={false}
        outerVignette={false}
        smooth={true}
        className="bg-transparent w-full h-full"
      />
      {/* Dark overlay ensuring perfect readability across all cards and text */}
      <div class="absolute inset-0 bg-[#101010]/70 pointer-events-none"></div>
    </div>

    {/* Site Content Layer */}
    <div class="relative z-10 sm:px-28 lg:px-20 px-9">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: "Montserrat Variable";
    src: url("/fonts/montserrat-latin-wght-normal.woff2")
      format("woff2-variations");
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }

  :root {
    --background: #101010;
    --container: #181818;
    --sec: #a476ff;
    --white: #dfdfdf;
    --white-icon: #f3f3f398;
    --white-icon-tr: #f3f3f310;
  }

  * {
    font-family:
      "Montserrat Variable",
      -apple-system,
      system-ui,
      sans-serif;
    box-sizing: border-box;
    padding: 0;
    margin: 0;
  }

  /* Scrollbar styles */
  ::-webkit-scrollbar {
    width: 10px;
  }

  ::-webkit-scrollbar-track {
    background: var(--background);
  }

  ::-webkit-scrollbar-thumb {
    background: #262626;
    border-radius: 8px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--sec);
  }

  * {
    scrollbar-width: thin;
    scrollbar-color: #262626 var(--background);
  }
</style>
