---
const certifications = [
  {
    name: "SAP Analytics Cloud",
    subtitle: "Business Analytics",
    issuer: "SAP",
    tag: "Enterprise",
  },
  {
    name: "AWS Cloud Compute",
    subtitle: "Cloud Architecture & EC2",
    issuer: "AWS",
    tag: "Cloud",
  },
  {
    name: "Salesforce AgentBlazer",
    subtitle: "AI Agents & Automation",
    issuer: "Salesforce",
    tag: "AI / CRM",
  },
  {
    name: "Power BI Data Analytics",
    subtitle: "Business Intelligence & Reporting",
    issuer: "Microsoft / BI",
    tag: "Data Viz",
  },
  {
    name: "AWS with SAP",
    subtitle: "Generative AI Fundamentals",
    issuer: "AWS & SAP",
    tag: "GenAI",
  },
  {
    name: "Data Engineering on AWS Foundations",
    subtitle: "Pipelines & Storage Architecture",
    issuer: "AWS",
    tag: "Data Eng",
  },
];

const courses = [
  { name: "Big Data Analytics", provider: "NPTEL", year: "2025" },
  { name: "Python Specialization", provider: "Coursera", year: "2025" },
];

const conference = {
  title: "Fuel Efficiency Vehicle Design",
  host: "Amity University",
};

const languages = [
  { language: "Tamil", level: "Native" },
  { language: "English", level: "Intermediate" },
  { language: "Japanese", level: "Beginner" },
];

const strengths = [
  "Strong Communication",
  "Team Building",
  "Situational Awareness",
  "Teamwork",
  "Work Management",
  "Active Listening",
];
---

<section id="certifications" class="py-12 border-t border-[#ffffff10] text-[var(--white)]">
  <div class="max-w-5xl mx-auto space-y-12">
    <div>
      <h2 class="text-sm font-semibold uppercase tracking-wider text-[var(--sec)] mb-2 shiny-sec">Credentials</h2>
      <h3 class="text-4xl md:text-5xl font-semibold tracking-tight">Certifications & Knowledge</h3>
    </div>

    <!-- Certifications Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {certifications.map((cert) => (
        <div class="p-5 rounded-2xl bg-[#1414149c] border border-[var(--white-icon-tr)] hover:border-[var(--sec)] transition-all duration-300 flex flex-col justify-between space-y-3">
          <div class="space-y-1">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono text-[var(--sec)] bg-[#a476ff15] px-2 py-0.5 rounded border border-[#a476ff25]">
                {cert.tag}
              </span>
              <span class="text-xs text-[var(--white-icon)] font-medium">
                {cert.issuer}
              </span>
            </div>
            <h4 class="text-base font-semibold text-[var(--white)] pt-1">
              {cert.name}
            </h4>
            <p class="text-xs text-[var(--white-icon)]">
              {cert.subtitle}
            </p>
          </div>
          <div class="flex items-center gap-1.5 text-xs text-[var(--white-icon)] pt-1 border-t border-[#ffffff0a]">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-[var(--sec)]">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
            <span>Verified Credential</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Additional Info: Courses, Languages, Conference, Strengths -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-4">
      <!-- Courses & Conference -->
      <div class="p-6 rounded-2xl bg-[#1414149c] border border-[var(--white-icon-tr)] space-y-4">
        <div class="flex items-center gap-2.5 text-[var(--sec)]">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/>
            <path d="M6 6h10"/>
            <path d="M6 10h10"/>
          </svg>
          <h4 class="text-lg font-medium text-[var(--white)]">Courses & Papers</h4>
        </div>

        <div class="space-y-3">
          {courses.map((course) => (
            <div class="p-3 rounded-xl bg-[#1c1c1c] border border-[#ffffff0a]">
              <div class="text-sm font-medium text-[var(--white)]">{course.name}</div>
              <div class="text-xs text-[var(--white-icon)]">{course.provider} • {course.year}</div>
            </div>
          ))}

          <div class="p-3 rounded-xl bg-[#1c1c1c] border border-[#ffffff0a]">
            <div class="text-xs font-mono text-[var(--sec)]">Conference Presentation</div>
            <div class="text-sm font-medium text-[var(--white)]">{conference.title}</div>
            <div class="text-xs text-[var(--white-icon)]">{conference.host}</div>
          </div>
        </div>
      </div>

      <!-- Languages -->
      <div class="p-6 rounded-2xl bg-[#1414149c] border border-[var(--white-icon-tr)] space-y-4">
        <div class="flex items-center gap-2.5 text-[var(--sec)]">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <line x1="2" y1="12" x2="22" y2="12"/>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
          </svg>
          <h4 class="text-lg font-medium text-[var(--white)]">Languages</h4>
        </div>

        <div class="space-y-2.5">
          {languages.map((item) => (
            <div class="flex items-center justify-between p-3 rounded-xl bg-[#1c1c1c] border border-[#ffffff0a]">
              <span class="text-sm font-medium text-[var(--white)]">{item.language}</span>
              <span class="text-xs px-2.5 py-1 rounded-full bg-[#262626] text-[var(--white-icon)]">
                {item.level}
              </span>
            </div>
          ))}
        </div>
      </div>

      <!-- Strengths -->
      <div class="p-6 rounded-2xl bg-[#1414149c] border border-[var(--white-icon-tr)] space-y-4">
        <div class="flex items-center gap-2.5 text-[var(--sec)]">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
          </svg>
          <h4 class="text-lg font-medium text-[var(--white)]">Professional Strengths</h4>
        </div>

        <div class="flex flex-wrap gap-2 pt-1">
          {strengths.map((str) => (
            <span class="text-xs px-3 py-1.5 rounded-lg bg-[#1c1c1c] text-[var(--white)] border border-[#ffffff10] flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-[var(--sec)]"></span>
              <span>{str}</span>
            </span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
