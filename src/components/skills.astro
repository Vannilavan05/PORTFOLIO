---
import SkillProficiency from "../React/SkillProficiency.tsx";
---

<section id="skills" class="py-12 border-t border-[#ffffff10] text-[var(--white)]">
  <div class="max-w-5xl mx-auto space-y-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wider text-[var(--sec)] mb-2 shiny-sec">
          Technical Skills
        </h2>
        <h3 class="text-4xl md:text-5xl font-semibold tracking-tight">
          Tools & Technologies
        </h3>
      </div>
      <p class="text-sm text-[var(--white-icon)] max-w-md">
        Overview of core tools, platforms, and database technologies utilized across real-world projects and internships.
      </p>
    </div>

    {/* Clean, Simple Tool Cards (No bars, no percentages) */}
    <SkillProficiency client:load />
  </div>
</section>
