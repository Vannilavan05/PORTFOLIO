---
const contactDetails = {
  name: "Vannilavan C",
  email: "vannilavanchandrasekaran@gmail.com",
  phone: "+91 9042214770",
  location: "Karur, Tamil Nadu, India",
  github: "https://github.com/Vannilavan05",
  githubUsername: "Vannilavan05",
  linkedin: "https://linkedin.com/in/vannilavan-chandrasekaran-537223317",
  linkedinName: "Vannilavan Chandrasekaran",
};
---

<section id="contact" class="w-full py-12 border-t border-[#ffffff10]">
  <div class="max-w-5xl mx-auto">
    <h2 class="text-sm font-semibold uppercase tracking-wider text-[var(--sec)] mb-2 shiny-sec">Connect</h2>
    <h3 class="text-4xl md:text-5xl font-semibold text-[var(--white)] mb-8 tracking-tight">
      Get In Touch
    </h3>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Contact Information Cards -->
      <div class="lg:col-span-5 space-y-4">
        <p class="text-base text-[var(--white-icon)] leading-relaxed">
          Open to AI & Data Science roles, software engineering internships, and collaborative tech projects. Feel free to contact me directly:
        </p>

        <div class="space-y-3 pt-2">
          <!-- Email Card -->
          <a
            href={`mailto:${contactDetails.email}`}
            class="flex items-center gap-3.5 p-4 rounded-2xl bg-[#1414149c] border border-[var(--white-icon-tr)] hover:border-[var(--sec)] transition-all group"
          >
            <div class="w-10 h-10 rounded-xl bg-[#202020] border border-[#ffffff10] flex items-center justify-center text-[var(--sec)] group-hover:scale-105 transition-transform">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="16" x="2" y="4" rx="2"/>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
              </svg>
            </div>
            <div class="overflow-hidden">
              <span class="block text-xs text-[var(--white-icon)]">Email Address</span>
              <span class="block text-sm font-medium text-[var(--white)] group-hover:text-[var(--sec)] transition-colors truncate">
                {contactDetails.email}
              </span>
            </div>
          </a>

          <!-- Phone Card -->
          <a
            href={`tel:${contactDetails.phone.replace(/\s+/g, '')}`}
            class="flex items-center gap-3.5 p-4 rounded-2xl bg-[#1414149c] border border-[var(--white-icon-tr)] hover:border-[var(--sec)] transition-all group"
          >
            <div class="w-10 h-10 rounded-xl bg-[#202020] border border-[#ffffff10] flex items-center justify-center text-[var(--sec)] group-hover:scale-105 transition-transform">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
            </div>
            <div>
              <span class="block text-xs text-[var(--white-icon)]">Phone Number</span>
              <span class="block text-sm font-medium text-[var(--white)] group-hover:text-[var(--sec)] transition-colors">
                {contactDetails.phone}
              </span>
            </div>
          </a>

          <!-- Location Card -->
          <div class="flex items-center gap-3.5 p-4 rounded-2xl bg-[#1414149c] border border-[var(--white-icon-tr)]">
            <div class="w-10 h-10 rounded-xl bg-[#202020] border border-[#ffffff10] flex items-center justify-center text-[var(--sec)]">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
            </div>
            <div>
              <span class="block text-xs text-[var(--white-icon)]">Location</span>
              <span class="block text-sm font-medium text-[var(--white)]">
                {contactDetails.location}
              </span>
            </div>
          </div>

          <!-- Socials row -->
          <div class="grid grid-cols-2 gap-3 pt-1">
            <a
              target="_blank"
              href={contactDetails.linkedin}
              class="flex items-center justify-center gap-2 p-3 rounded-xl bg-[#1414149c] border border-[var(--white-icon-tr)] hover:border-[var(--sec)] text-sm text-[var(--white-icon)] hover:text-white transition"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4">
                <path d="M18.3362 18.339H15.6707V14.1622C15.6707 13.1662 15.6505 11.8845 14.2817 11.8845C12.892 11.8845 12.6797 12.9683 12.6797 14.0887V18.339H10.0142V9.75H12.5747V10.9207H12.6092C12.967 10.2457 13.837 9.53325 15.1367 9.53325C17.8375 9.53325 18.337 11.3108 18.337 13.6245V18.339H18.3362ZM7.00373 8.57475C6.14573 8.57475 5.45648 7.88025 5.45648 7.026C5.45648 6.1725 6.14648 5.47875 7.00373 5.47875C7.85873 5.47875 8.55173 6.1725 8.55173 7.026C8.55173 7.88025 7.85798 8.57475 7.00373 8.57475ZM8.34023 18.339H5.66723V9.75H8.34023V18.339ZM19.6697 3H4.32923C3.59498 3 3.00098 3.5805 3.00098 4.29675V19.7033C3.00098 20.4202 3.59498 21 4.32923 21H19.6675C20.401 21 21.001 20.4202 21.001 19.7033V4.29675C21.001 3.5805 20.401 3 19.6675 3H19.6697Z"/>
              </svg>
              <span>LinkedIn</span>
            </a>

            <a
              target="_blank"
              href={contactDetails.github}
              class="flex items-center justify-center gap-2 p-3 rounded-xl bg-[#1414149c] border border-[var(--white-icon-tr)] hover:border-[var(--sec)] text-sm text-[var(--white-icon)] hover:text-white transition"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-4">
                <path d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"/>
              </svg>
              <span>GitHub</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Quick Message Form -->
      <div class="lg:col-span-7 bg-[#1414149c] p-6 sm:p-8 rounded-2xl border border-[var(--white-icon-tr)]">
        <h4 class="text-xl font-semibold text-[var(--white)] mb-4">Send a Direct Message</h4>
        <form
          id="contact-form"
          class="flex flex-col gap-4"
        >
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-1">
              <label for="contact-name" class="text-xs text-[var(--white-icon)]">Your Name</label>
              <input
                id="contact-name"
                type="text"
                name="name"
                placeholder="John Doe"
                required
                class="w-full px-4 py-2.5 bg-[#1b1b1b] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-xl focus:outline-none focus:border-[var(--sec)] text-sm transition"
              />
            </div>
            <div class="space-y-1">
              <label for="contact-email" class="text-xs text-[var(--white-icon)]">Your Email</label>
              <input
                id="contact-email"
                type="email"
                name="email"
                placeholder="john@example.com"
                required
                class="w-full px-4 py-2.5 bg-[#1b1b1b] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-xl focus:outline-none focus:border-[var(--sec)] text-sm transition"
              />
            </div>
          </div>

          <div class="space-y-1">
            <label for="contact-subject" class="text-xs text-[var(--white-icon)]">Subject</label>
            <input
              id="contact-subject"
              type="text"
              name="subject"
              placeholder="Opportunity / Collaboration inquiry"
              required
              class="w-full px-4 py-2.5 bg-[#1b1b1b] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-xl focus:outline-none focus:border-[var(--sec)] text-sm transition"
            />
          </div>

          <div class="space-y-1">
            <label for="contact-message" class="text-xs text-[var(--white-icon)]">Message</label>
            <textarea
              id="contact-message"
              name="message"
              placeholder="Write your message here..."
              rows="5"
              required
              class="w-full px-4 py-2.5 bg-[#1b1b1b] text-[var(--white)] border border-[var(--white-icon-tr)] rounded-xl focus:outline-none focus:border-[var(--sec)] text-sm resize-none transition"
            ></textarea>
          </div>

          <button
            type="submit"
            id="contact-submit-btn"
            class="mt-2 py-3 px-6 bg-[var(--sec)] text-[var(--background)] font-medium rounded-xl hover:opacity-90 transition flex items-center justify-center gap-2 text-sm"
          >
            <span>Send Message</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="22" y1="2" x2="11" y2="13"></line>
              <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
            </svg>
          </button>
        </form>

        <div
          id="form-success-box"
          class="hidden mt-4 p-4 rounded-xl bg-[#102a1d] border border-[#22c55e40] text-[#86efac] text-sm flex items-center gap-3"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
            <polyline points="22 4 12 14.01 9 11.01"/>
          </svg>
          <div>
            <p class="font-medium">Thank you for reaching out!</p>
            <p class="text-xs opacity-80">Opening your email client to dispatch to vannilavanchandrasekaran@gmail.com.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  const contactForm = document.getElementById("contact-form");
  const successBox = document.getElementById("form-success-box");

  if (contactForm) {
    contactForm.addEventListener("submit", (e) => {
      e.preventDefault();
      const formData = new FormData(contactForm);
      const name = formData.get("name") || "";
      const email = formData.get("email") || "";
      const subject = formData.get("subject") || "Portfolio Inquiry";
      const message = formData.get("message") || "";

      // Open mailto seamlessly with prefilled subject and body
      const mailtoUrl = `mailto:vannilavanchandrasekaran@gmail.com?subject=${encodeURIComponent(
        subject + " - from " + name
      )}&body=${encodeURIComponent(
        `Hi Vannilavan,\n\n${message}\n\nFrom: ${name} (${email})`
      )}`;

      window.location.href = mailtoUrl;

      if (successBox) {
        successBox.classList.remove("hidden");
        contactForm.reset();
      }
    });
  }
</script>
