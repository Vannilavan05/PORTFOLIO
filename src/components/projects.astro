---
import InteractiveProjects from "../React/InteractiveProjects.tsx";
---

<section
  id="projects"
  class="py-12 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto space-y-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wider text-[var(--sec)] mb-2 shiny-sec">Portfolio Showcase</h2>
        <h3 class="text-4xl md:text-5xl font-semibold tracking-tight">Featured Projects</h3>
      </div>
      <p class="text-sm text-[var(--white-icon)] max-w-md">
        Real-world applications built with a focus on data integrity, machine learning, cloud architecture, and automation.
      </p>
    </div>

    {/* Interactive Projects with Filtering and Architecture Modals */}
    <InteractiveProjects client:load />

    {/* Bottom GitHub Banner */}
    <div class="p-6 rounded-2xl border border-[var(--white-icon-tr)] bg-[#1414149c] flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-3 text-left">
        <div class="size-10 rounded-xl bg-[#202020] border border-[#ffffff15] flex items-center justify-center text-[var(--sec)]">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
            <path d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"/>
          </svg>
        </div>
        <div>
          <h5 class="text-base font-semibold text-[var(--white)]">Looking for more source code?</h5>
          <p class="text-xs text-[var(--white-icon)]">Explore additional code repositories, scripts, and experiments on GitHub.</p>
        </div>
      </div>

      <a
        target="_blank"
        rel="noreferrer"
        href="https://github.com/Vannilavan05"
        class="shrink-0 flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#222222] hover:bg-[#2c2c2c] border border-[#ffffff15] text-sm text-[var(--white)] transition"
      >
        <span>github.com/Vannilavan05</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="7" y1="17" x2="17" y2="7"></line>
          <polyline points="7 7 17 7 17 17"></polyline>
        </svg>
      </a>
    </div>
  </div>
</section>
